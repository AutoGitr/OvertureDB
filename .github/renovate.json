{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "abandonments:recommended",
    ":configMigration"
  ],
  "pinDigests": true,
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "labels": ["deps"],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "schedule": ["* 5 * * 2"],
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 5 * * 1"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "minimumReleaseAge": null,
    "schedule": ["at any time"],
    "vulnerabilityFixStrategy": "lowest"
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["ci"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions Updates",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchDatasources": ["github-runners"],
      "enabled": true,
      "groupName": "GitHub runners",
      "minimumReleaseAge": null,
      "automerge": false
    },
    {
      "description": "Python must be the same version in .python-version and the image that builds the container",
      "matchPackageNames": ["python"],
      "groupName": "Python Version"
    },
    {
      "matchUpdateTypes": ["pin", "patch", "digest", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "schedule": ["at any time"]
    },
    {
      "matchUpdateTypes": ["pin", "digest", "pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "7 days"
    }
  ],
  "customManagers": [
    {
      "description": "The uv version every uv command and setup-uv step requires",
      "customType": "regex",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": ["required-version = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    }
  ]
}
